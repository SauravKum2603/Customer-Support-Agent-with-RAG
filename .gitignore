# Ignore local environment files containing private API keys or tokens
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore operating system system-specific files
.DS_Store
Thumbs.db
desktop.ini

# Ignore local dependencies, project runtimes, and execution logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Ignore local n8n storage files if you run via Docker or local binary
.n8n/
